<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ DShield Child"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#2196F3"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="15sp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnEnableAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 Enable Device Admin"
            android:textSize="16sp"
            android:visibility="gone"
            android:padding="16dp"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnTestLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Test Lock Device"
            android:textSize="16sp"
            android:visibility="gone"
            android:padding="16dp"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCheckStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Refresh Status"
            android:textSize="16sp"
            android:padding="16dp"
            android:backgroundTint="#2196F3" />

        <Button
            android:id="@+id/removedevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            android:textSize="16sp"
            android:padding="16dp"
            android:text="Remove" />

        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:text="Button" />

    </LinearLayout>

</ScrollView>
